{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2023",
    "lib": ["ES2023"],
    "allowJs": false,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["**/*.d.ts"]
}
