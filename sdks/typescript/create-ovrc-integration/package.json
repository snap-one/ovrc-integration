{
  "name": "@snap-one/create-ovrc-integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snap-one/ovrc-integration.git"
  },
  "version": "1.0.1",
  "bin": {
    "create-integration": "dist/create.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outfile dist/create.js --target node --format esm --bundle && cp -r src/template dist",
    "prepack": "bun run build"
  },
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/prompts": "^2.4.9",
    "@types/semver": "^7.7.1",
    "@types/validate-npm-package-name": "^4.0.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "prompts": "^2.4.2",
    "semver": "^7.8.5",
    "validate-npm-package-name": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
