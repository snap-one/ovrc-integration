{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Integration Manifest",
  "description": "Schema for the integration manifest.",
  "type": "object",
  "required": ["name", "version", "description", "category", "identification", "kind"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable integration name. Example: Samsung TV"
    },
    "kind": {
      "type": "string",
      "enum": ["wasm", "js"],
      "description": "The kind of integration associated with this manifest."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version of the integration. Example: 1.0.0"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable integration description. Example: Integration for Samsung TVs."
    },
    "category": {
      "enum": ["display", "camera"],
      "description": "Integration category."
    },
    "identification": {
      "type": "object",
      "required": ["discovery"],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/discovery"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "discovery": {
      "description": "A single object, or an $or of discoveryData objects.",
      "oneOf": [
        {
          "$ref": "#/$defs/discoveryData"
        },
        {
          "type": "object",
          "required": ["$or"],
          "additionalProperties": false,
          "properties": {
            "$or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/discoveryData"
              }
            }
          }
        }
      ]
    },
    "discoveryData": {
      "type": "object",
      "minProperties": 1,
      "description": "A single discovery matcher. Properties are AND'd together.",
      "properties": {
        "mac_oui": {
          "description": "MAC OUI prefix, or an $or of MAC OUI prefixes.",
          "oneOf": [
            {
              "type": "string",
              "description": "MAC OUI prefix. Example: 00:1A:2B:* or 00:1A:2B:*:4D:*"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "description": "MAC OUI prefix. Example: 00:1A:2B:* or 00:1A:2B:*:4D:*"
                  }
                }
              }
            }
          ]
        },
        "snmp": {
          "description": "SNMP discovery matcher, or an $or of SNMP matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/snmp"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/snmp"
                  }
                }
              }
            }
          ]
        },
        "ssdp": {
          "description": "SSDP discovery matcher, or an $or of SSDP matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/ssdp"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/ssdp"
                  }
                }
              }
            }
          ]
        },
        "sddp": {
          "description": "SDDP discovery matcher, or an $or of SDDP matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/sddp"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/sddp"
                  }
                }
              }
            }
          ]
        },
        "dnssd": {
          "description": "DNS-SD discovery matcher, or an $or of DNS-SD matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/dnssd"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/dnssd"
                  }
                }
              }
            }
          ]
        },
        "mdns": {
          "description": "mDNS discovery matcher, or an $or of mDNS matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/mdns"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/mdns"
                  }
                }
              }
            }
          ]
        },
        "pjlink": {
          "description": "PJLink discovery matcher, or an $or of PJLink matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/pjlink"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/pjlink"
                  }
                }
              }
            }
          ]
        },
        "onvif": {
          "description": "ONVIF discovery matcher, or an $or of ONVIF matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/onvif"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/onvif"
                  }
                }
              }
            }
          ]
        },
        "upnp": {
          "description": "UPnP discovery matcher, or an $or of UPnP matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/upnp"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/upnp"
                  }
                }
              }
            }
          ]
        },
        "wsdiscovery": {
          "description": "WS-Discovery discovery matcher, or an $or of WS-Discovery matchers.",
          "oneOf": [
            {
              "$ref": "#/$defs/wsdiscovery"
            },
            {
              "type": "object",
              "required": ["$or"],
              "additionalProperties": false,
              "properties": {
                "$or": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/wsdiscovery"
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "snmp": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "sysName": {
          "type": "string",
          "description": "Administratively assigned node name. Example: *switch*"
        },
        "sysDescr": {
          "type": "string",
          "description": "System description of the device. Example: *Cisco*"
        },
        "sysObjectID": {
          "type": "string",
          "description": "Vendor OID. Example: .1.3.6.1.4.1.25053.3.1.5.20"
        }
      },
      "additionalProperties": false,
      "description": "SNMP discovery matcher. Properties are AND'd together."
    },
    "ssdp": {
      "type": "object",
      "required": ["services"],
      "properties": {
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "st": {
                "type": "string",
                "description": "Search target. Example: urn:schemas-upnp-org:device:MediaServer:*"
              },
              "usn": {
                "type": "string",
                "description": "Unique service name (without the trailing ::ST). Example: uuid:df402f80-da50-11e1-9b23-00255db12346"
              }
            },
            "additionalProperties": false,
            "description": "Single SSDP service criterion. Properties are AND'd together."
          },
          "description": "SSDP services advertised by the device. Services are AND'd together."
        }
      },
      "additionalProperties": false,
      "description": "SSDP discovery matcher."
    },
    "sddp": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "type": {
          "type": "string",
          "description": "Device type. Example: acme:receiver:ACME-100"
        },
        "manufacturer": {
          "type": "string",
          "description": "Manufacturer of the device. Example: Acme Corporation"
        },
        "hostname_prefix": {
          "type": "string",
          "description": "Hostname prefix of the device. Example: core1 when hostname is core1-AABBCCDDEE"
        },
        "hostname_suffix": {
          "type": "string",
          "description": "Hostname suffix of the device. Example: AABBCCDDEE when hostname is core1-AABBCCDDEE"
        },
        "driver": {
          "type": "string",
          "description": "Driver name. Example: acme-receiver.c4z"
        },
        "model": {
          "type": "string",
          "description": "Model of the device. Example: ACME-100"
        },
        "primary_proxy": {
          "type": "string",
          "description": "Primary proxy used by the device. Example: receiver"
        },
        "proxies": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Proxy used by the device. Example: receiver"
          },
          "description": "List of proxies used by the device. AND'd together."
        }
      },
      "additionalProperties": false,
      "description": "SDDP discovery matcher. Properties are AND'd together."
    },
    "mdns": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "description": "Service name. Example: LivingRoomTV.local"
        }
      },
      "additionalProperties": false,
      "description": "mDNS discovery matcher. Properties are AND'd together."
    },
    "pjlink": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "description": "Device name. Example: *Projector*"
        },
        "inf1": {
          "type": "string",
          "description": "Manufacturer of the device. Example: Epson"
        },
        "inf2": {
          "type": "string",
          "description": "Model of the device. Example: PowerLite 2250U"
        },
        "clss": {
          "type": "string",
          "description": "Class of the device. Example: 1"
        }
      },
      "additionalProperties": false,
      "description": "PJLink discovery matcher. Properties are AND'd together."
    },
    "dnssd": {
      "type": "object",
      "required": ["services"],
      "properties": {
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "name": {
                "type": "string",
                "description": "Service instance name. Example: LivingRoomTV"
              },
              "serviceType": {
                "type": "string",
                "description": "Service type. Example: _googlecast._tcp.local"
              },
              "port": {
                "type": "string",
                "description": "Port number. Example: 8008"
              },
              "protocol": {
                "type": "string",
                "description": "Transport protocol. Example: tcp or udp."
              },
              "txtRecords": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "TXT record (key=value or bare key). Example: model=XBR-65X850G"
                },
                "description": "TXT attributes associated with the service. AND'd together."
              }
            },
            "additionalProperties": false,
            "description": "Single DNS-SD service criterion. Properties are AND'd together."
          },
          "description": "DNS-SD services advertised by the device. Services are AND'd together."
        }
      },
      "additionalProperties": false,
      "description": "DNS-SD discovery matcher."
    },
    "onvif": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "ONVIF profile. Example: PROFILE_T."
          },
          "description": "ONVIF profiles supported by the device. Profiles are AND'd together."
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "namespace": {
                "type": "string",
                "description": "ONVIF service namespace. Example: http://www.onvif.org/ver10/device/wsdl"
              },
              "xAddr": {
                "type": "string",
                "description": "ONVIF service address. Example: /onvif/device_service"
              },
              "version": {
                "type": "string",
                "description": "ONVIF service version. Comparisons and ranges supported. Namespace must also be specified. Examples: >2.1, 1.0 - 1.2"
              }
            },
            "additionalProperties": false,
            "dependentRequired": {
              "version": ["namespace"]
            },
            "description": "ONVIF service supported by the device. Properties are AND'd together."
          },
          "description": "ONVIF services supported by the device. Services are AND'd together."
        }
      },
      "additionalProperties": false,
      "description": "ONVIF discovery matcher. Properties are AND'd together."
    },
    "upnp": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "UPnP discovery matcher. Properties are AND'd together.",
      "properties": {
        "deviceType": {
          "type": "string",
          "description": "The device's type. Example: urn:dial-multiscreen-org:device:dialreceiver:1"
        },
        "location": {
          "type": "string",
          "description": "The location href. Example: http://192.168.1.104:7678/nservice/"
        },
        "manufacturerURL": {
          "type": "string",
          "description": "The manufacturer's URL. Example: http://www.samsung.com/sec"
        },
        "modelName": {
          "type": "string",
          "description": "The model's name."
        },
        "modelNumber": {
          "type": "string",
          "description": "The device's model number. Example: 1.2.0"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "serviceType": {
                "type": "string",
                "description": "Search target. Example: urn:dial-multiscreen-org:service:dial:*"
              },
              "serviceId": {
                "type": "string",
                "description": "Search target. Example: urn:dial-multiscreen-org:serviceId:*"
              },
              "controlURL": {
                "type": "string",
                "description": "Search target. Example: /RCR/control/dial"
              },
              "eventSubURL": {
                "type": "string",
                "description": "Search target. Example: /RCR/event/dial"
              },
              "scpdURL": {
                "type": "string",
                "description": "Search target. Example: /RCR/nservice/dial"
              }
            },
            "additionalProperties": false,
            "description": "Single UPnP service criterion. Properties are AND'd together."
          },
          "description": "UPnP services advertised by the device. Services are AND'd together."
        }
      },
      "anyOf": [
        { "required": ["deviceType"] },
        { "required": ["manufacturerURL"] },
        { "required": ["modelName"] },
        { "required": ["services"] }
      ]
    },
    "wsdiscovery": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "WS-Discovery discovery matcher. Properties are AND'd together.",
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A type advertised by the device. Example: dn:NetworkVideoTransmitter"
          },
          "description": "WS-Discovery types advertised by the device. Types are AND'd together, and each must match a different advertised type."
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A scope advertised by the device. Example: onvif://www.onvif.org/manufacturer/Hanwha%20Vision"
          },
          "description": "WS-Discovery scopes advertised by the device. Scopes are AND'd together, and each must match a different advertised scope."
        },
        "xAddr": {
          "type": "string",
          "minLength": 1,
          "description": "The advertised transport address, with the host removed. Example: /onvif/device_service"
        }
      }
    }
  }
}
