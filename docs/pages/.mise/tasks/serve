#!/usr/bin/env bash

#MISE description="Serve hugo and mdbook"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"

# mdbook needs a populated src/ before it can build, so render once up front.
hugo --source hugo --destination ../mdbook/content --cleanDestinationDir

trap 'kill 0' EXIT
hugo --source hugo --destination ../mdbook/content --watch --cleanDestinationDir &
mdbook serve mdbook --open
